# shellcheck disable=SC2034

# Copied to .env by setup.sh; the justfile and pm2/service.config.js load .env.
# Every value below is the default; delete a line to keep the default.

# The gate. `off` runs the proof unsandboxed: a miner's laptop without bubblewrap, never a validator.
VERIFY_SANDBOX=bwrap
# Seconds the proof may take to elaborate; over it is a rejection.
VERIFY_LEAN_TIMEOUT=900
# Memory cap for the proof via `systemd-run --user`, in MB; 0 disables.
VERIFY_LEAN_MEMORY_MB=16384
# Compiler, translator and trusted-module build timeout, separately from proofs.
VERIFY_TOOL_TIMEOUT=900
# Seconds the service gives the whole gate per submission, every stage; over it is a rejection.
VERIFY_TOTAL_TIMEOUT=2700

# Single-corpus override: a name from validator/corpora.toml (`just corpora`
# lists them, and one is marked default there), or a directory. A held-out corpus
# belongs in that file with `public = false`, which keeps its per-file numbers
# inside the validator. Leave unset for gate evaluation on BOTH stage 1 and stage 2.
# Standalone just bench still defaults to corpus-stage1.
# `just corpus-download` fetches the Silesia corpus into data/benchmark/{silesia,silesia-subset}.
#VERIFY_CORPUS=

# Where `just corpus-pull` fetches the two scoring corpora from. The defaults point at
# the dataset repositories; override either one for a local checkout, a mirror, or a
# round-specific corpus. A path works exactly as well as a URL.
#CORPUS_STAGE1_REMOTE=https://github.com/conjectures-io/conjectures-compression-corpus-1
#CORPUS_STAGE2_REMOTE=https://github.com/conjectures-io/conjectures-compression-corpus-2

# The seed `just corpus-build --stage 2` derives the hidden corpus from. There is no
# default and there must not be one: anyone holding this value can rebuild the held-out
# set byte for byte and tune against it, which is the whole thing stage 2 exists to stop.
# .env is gitignored. Generate one with `openssl rand -hex 32` and keep it off the
# public repo, out of CI logs, and off the miners' side of the wire. Only needed to
# re-cut stage 2; scoring against it just needs `just corpus-pull`.
#BENCHMARK_STAGE2_SEED=

# --- The store --------------------------------------------------------------------
# Postgres holds submissions, registrations, entitlement claims and the weight audit.
# `just db-up` starts it from compose.yaml using exactly these values; `just db-migrate`
# applies the schema. DATABASE_URL, if set, overrides all five and is what a validator
# pointing at a managed database sets instead.
POSTGRES_USER=conjectures
POSTGRES_PASSWORD=change-me
POSTGRES_DB=conjectures
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
#DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
# Password for the read-only `monitor` role created on first cluster init.
#MONITOR_PASSWORD=monitor
# Password for `platform_api`, the role conjectures-validator's API uses to serve this
# competition (`just db-grant-platform` creates it and resets its grants; see
# docs/OPERATIONS.md). Its COMPETITION_DATABASE_URL carries the same password.
#PLATFORM_API_PASSWORD=
# On a host that also runs the platform's compose stack: put this database on its network.
#COMPOSE_FILE=compose.yaml:compose.platform.yaml

# --- Baselines --------------------------------------------------------------------
# The one-shot deflate-baseline-seed process seeds miner/examples as the reference
# Pareto frontier on every start (pm2 start, just up). Set to 0 on a host that must not seed.
#BASELINE_SEED_ON_START=1

# --- The submission service ---------------------------------------------------------
SERVICE_HOST=0.0.0.0
SERVICE_PORT=9200
# Where the two submitted files per submission are written. The database holds
# everything else; this directory holds only what the gate needs to read back.
SERVICE_FILES=validator/.work/submissions
# Signed writes allowed per hotkey per minute. Counted in Postgres, so the limit is the
# same whether one API worker is running or four.
SERVICE_RATE_PER_MINUTE=10
# How far a submission's signed timestamp may be from the validator's clock, in seconds.
# Narrow enough to make a captured request useless, wide enough for ordinary clock skew.
SERVICE_SIGNATURE_WINDOW_SECONDS=300
# Host header allowlist. `*` accepts anything, which is right behind a reverse proxy that
# already filters; set it to the validator's real hostname when the API is exposed directly.
SERVICE_ALLOWED_HOSTS=*
# Identifies this gate worker in the submissions table. Defaults to the hostname and pid,
# which is enough to tell two workers apart on one box.
#SERVICE_WORKER_ID=
# Seconds a claimed submission may sit unfinished before another worker may take it. Must
# exceed VERIFY_TOTAL_TIMEOUT, or a slow but live verification gets stolen mid-gate.
#SERVICE_STALE_CLAIM_SECONDS=7200

# --- The chain --------------------------------------------------------------------
# The subnet the validator watches and sets weights on. The chain workers need the
# bittensor SDK: `./setup.sh --chain`.
NETUID=66
BITTENSOR_NETWORK=finney
# Registration blocks are usually older than a lite node's pruned-state window, so their
# on-chain times are read from an archive node instead. Only touched on a real registration.
BITTENSOR_ARCHIVE_NETWORK=archive
# Seconds between chain-watcher polls; blocks are ~12s apart, so half that catches every head.
#CHAIN_POLL_SECONDS=6

# The wallet the weight setter signs with. Its hotkey must be a registered validator on
# NETUID to set weights. An unregistered wallet can still generate scoring snapshots.
BITTENSOR_WALLET_NAME=default
BITTENSOR_WALLET_HOTKEY=default
#BITTENSOR_WALLET_PATH=~/.bittensor/wallets

# --- Weight setting ---------------------------------------------------------------
# This is the validator's ONLY set_weights caller: it sets the whole vector, the
# treasury's share to uid 121 and the competition's share (20%) by score (validator/
# scoring/split.py; on netuid 66 both are code constants). Miner scores are multiplied by
# the competition's share without renormalizing; everything the competition does not pay
# a miner -- baselines, deregistered hotkeys, anything the two scoring components did not
# claim -- goes to the treasury, not the burn uid. It replaced conjectures-validator's
# emissions worker, so while it is in dry-run the validator sets no weights at all.
#
# Compute and record the vector without submitting it: the whole path except the last
# call. Requires chain access for block/metagraph reads, but not validator registration.
# Set WEIGHT_DRY_RUN=0 explicitly to submit live weights.
WEIGHT_DRY_RUN=1
# Off mainnet only: the uid that takes the treasury share (default: WEIGHT_BURN_UID).
# On netuid 66 the treasury is uid 121 and any other value refuses to start.
# (WEIGHT_COLLECTOR_UID is accepted as an older name for it.)
#WEIGHT_TREASURY_UID=
# The treasury's registered hotkey; safer against uid reassignment. When set and absent from
# the metagraph, the epoch is skipped (recorded), never paid elsewhere. Off mainnet it also
# locates the treasury uid; on netuid 66 it must sit at uid 121. (Or WEIGHT_COLLECTOR_HOTKEY.)
#WEIGHT_TREASURY_HOTKEY=<registered treasury SS58 hotkey>
# Off mainnet only: the competition's share of the validator's weight (default 0.20). On
# netuid 66 it is 0.20 and any other value refuses to start.
#WEIGHT_COMPETITION_SHARE=0.20
# The most alpha one (hotkey, submission) pair is ever paid (default 3600, half a day of the
# subnet's alpha). Past it the pair's weight is 0 and its share goes to the treasury.
#ALPHA_TOTAL_SUBMISSION_BOUNTY=3600
# Burn the competition's share, ignoring the scores -- a paused or unopened round. The
# treasury's share is paid as usual.
#WEIGHT_BURN_MODE=1
# Where burn mode sends the competition's share (default 121, the treasury, so on netuid 66
# burn mode pays the treasury everything). Never paid as a miner. Off mainnet, pick a uid
# that exists on your subnet; an absent one pays the treasury instead.
WEIGHT_BURN_UID=121
# Set this many blocks (or fewer) before each epoch boundary, so the vector lands just
# before consensus reads it while leaving time for inclusion.
WEIGHT_SET_MARGIN=12
WEIGHT_POLL_SECONDS=12
# Retain recent API snapshots for pagination; always keep the latest valid one per subnet.
# Cleanup clears JSON payloads only, preserving weight rows, scores and bounty history.
API_SNAPSHOT_RETENTION_SECONDS=3600
API_SNAPSHOT_CLEANUP_INTERVAL_SECONDS=60
API_SNAPSHOT_CLEANUP_BATCH_SIZE=10

# --- Scoring ----------------------------------------------------------------------
# Within the compression budget: all of it to the Pareto frontier; the recent-improvement
# component is off (the defaults in validator/scoring/config.py are the same).
# Unpaid allocations go to the treasury without renormalizing miner shares. See
# docs/SCORING.md for why the default weight function is the one it is.
SCORING_METHOD=local-global-improvement-space-log
SCORING_PARETO_SHARE=1.0
SCORING_IMPROVEMENT_SHARE=0.0
# Only used when SCORING_IMPROVEMENT_SHARE > 0: how many recent improvements are paid, how
# much better than the record a submission must be to count (relative), and how fast the
# shares decay from newest to oldest.
SCORING_IMPROVEMENT_WINDOW=10
SCORING_IMPROVEMENT_THRESHOLD=0.0025
SCORING_IMPROVEMENT_DECAY=0.6
# Inclusive balanced scoring limits; not benchmark execution limits.
SCORING_MAX_TIME_RATIO=10.0
SCORING_MAX_RATIO_PCT=40

# Optional explicit scoring corpus-content set; mixed contexts otherwise fail closed.
#SCORING_CORPORA={"corpus-stage1":"<sha256>","corpus-stage2":"<sha256>"}

# External reference compressors are opt-in; default runs pair candidate + incumbent.
VERIFY_BENCH_BARS=0

# Shared by the gate, bench, bench-db and baseline-seed.
VERIFY_BENCH_REPS=11
VERIFY_BENCH_WARMUP=1
VERIFY_BENCH_TIMEOUT=300
VERIFY_BENCH_MEMORY_MB=2048
VERIFY_BENCH_BUILD_MEMORY_MB=4096
VERIFY_BENCH_KEEP=auto
# CPU affinity is host-specific; choose a quiet CPU or CPU set on the benchmark host.
#VERIFY_BENCH_CPUS=2
# Admission uses 2000 bootstrap draws and a strictly positive one-sided 95% lower
# gain bound. These are versioned policy constants, not environment overrides.

# --- Observability (Axiom) --------------------------------------------------------
# Structured events from all four processes, in the conjectures platform's envelope, to the
# same dataset the platform uses (validator/observability/axiom.py; docs/OPERATIONS.md lists
# the events). Off unless BOTH the token and the dataset are set; then ingestion is batched on
# a background thread and never blocks or fails a process.
#AXIOM_TOKEN=xaat-...
#AXIOM_DATASET=
# Free-form deployment tag on every event (prod, dev, a host name). Default: default.
#AXIOM_ENVIRON=
# API base; the EU region is https://api.eu.axiom.co. Default: https://api.axiom.co.
#AXIOM_URL=
