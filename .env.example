# Copied to .env by setup.sh; the justfile and pm2/service.config.js load .env.
# Every value below is the default; delete a line to keep the default.

# The gate. `off` runs the proof unsandboxed: a miner's laptop without bubblewrap, never a validator.
VERIFY_SANDBOX=bwrap
# Seconds the proof may take to elaborate; over it is a rejection.
VERIFY_LEAN_TIMEOUT=900
# Memory cap for the proof via `systemd-run --user`, in MB; 0 disables.
VERIFY_LEAN_MEMORY_MB=16384
# Compiler, translator and trusted-module build timeout, separately from proofs.
VERIFY_TOOL_TIMEOUT=900
# Set this on a separate scorer to the output of just verification-fingerprint.
# VERIFY_REQUIRED_FINGERPRINT=
# Seconds the service gives the whole gate per submission, every stage; over it is a rejection.
VERIFY_TOTAL_TIMEOUT=2700

# Which corpus to score against: a name from validator/corpora.toml (`just corpora`
# lists them, and one is marked default there), or a directory. A held-out corpus
# belongs in that file with `public = false`, which keeps its per-file numbers
# inside the validator. Leave unset for the default.
# A validator running the staged benchmark points this at the hidden stage 2:
#   VERIFY_CORPUS=corpus-stage2
# `just corpus-download` fetches the Silesia corpus into data/benchmark/{silesia,silesia-subset}.
#VERIFY_CORPUS=

# Where `just corpus-pull` fetches the two scoring corpora from. The defaults point at
# the dataset repositories; override either one for a local checkout, a mirror, or a
# round-specific corpus. A path works exactly as well as a URL.
#CORPUS_STAGE1_REMOTE=https://github.com/conjectures-io/conjectures-compression-corpus-1
#CORPUS_STAGE2_REMOTE=https://github.com/conjectures-io/conjectures-compression-corpus-2

# The seed `just corpus-build --stage 2` derives the hidden corpus from. There is no
# default and there must not be one: anyone holding this value can rebuild the held-out
# set byte for byte and tune against it, which is the whole thing stage 2 exists to stop.
# .env is gitignored. Generate one with `openssl rand -hex 32` and keep it off the
# public repo, out of CI logs, and off the miners' side of the wire. Only needed to
# re-cut stage 2; scoring against it just needs `just corpus-pull`.
#BENCHMARK_STAGE2_SEED=

# --- The store --------------------------------------------------------------------
# Postgres holds submissions, registrations, entitlement claims and the weight audit.
# `just db-up` starts it from compose.yaml using exactly these values; `just db-migrate`
# applies the schema. DATABASE_URL, if set, overrides all five and is what a validator
# pointing at a managed database sets instead.
POSTGRES_USER=conjectures
POSTGRES_PASSWORD=change-me
POSTGRES_DB=conjectures
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
#DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
# Password for the read-only `monitor` role created on first cluster init.
#MONITOR_PASSWORD=monitor

# --- The submission service ---------------------------------------------------------
SERVICE_HOST=0.0.0.0
SERVICE_PORT=9200
# Where the two submitted files per submission are written. The database holds
# everything else; this directory holds only what the gate needs to read back.
SERVICE_FILES=validator/.work/submissions
# Signed writes allowed per hotkey per minute. Counted in Postgres, so the limit is the
# same whether one API worker is running or four.
SERVICE_RATE_PER_MINUTE=10
# How far a submission's signed timestamp may be from the validator's clock, in seconds.
# Narrow enough to make a captured request useless, wide enough for ordinary clock skew.
SERVICE_SIGNATURE_WINDOW_SECONDS=300
# Host header allowlist. `*` accepts anything, which is right behind a reverse proxy that
# already filters; set it to the validator's real hostname when the API is exposed directly.
SERVICE_ALLOWED_HOSTS=*
# Identifies this gate worker in the submissions table. Defaults to the hostname and pid,
# which is enough to tell two workers apart on one box.
#SERVICE_WORKER_ID=
# Seconds a claimed submission may sit unfinished before another worker may take it. Must
# exceed VERIFY_TOTAL_TIMEOUT, or a slow but live verification gets stolen mid-gate.
#SERVICE_STALE_CLAIM_SECONDS=7200

# --- The chain --------------------------------------------------------------------
# The subnet the validator watches and sets weights on. The chain workers need the
# bittensor SDK: `./setup.sh --chain`.
NETUID=66
BITTENSOR_NETWORK=finney
# Registration blocks are usually older than a lite node's pruned-state window, so their
# on-chain times are read from an archive node instead. Only touched on a real registration.
BITTENSOR_ARCHIVE_NETWORK=archive
# Seconds between chain-watcher polls; blocks are ~12s apart, so half that catches every head.
#CHAIN_POLL_SECONDS=6

# The wallet the weight setter signs with. Its hotkey must be a registered validator on
# NETUID, or the worker refuses to start.
BITTENSOR_WALLET_NAME=default
BITTENSOR_WALLET_HOTKEY=default
#BITTENSOR_WALLET_PATH=~/.bittensor/wallets

# --- Weight setting ---------------------------------------------------------------
# Compute and record the vector without submitting it: the whole path except the last
# call. Use it to watch what a live round would pay before a validator hotkey exists.
#WEIGHT_DRY_RUN=1
# Emit everything to the burn uid, ignoring the scores -- a paused or unopened round.
#WEIGHT_BURN_MODE=1
# Where unclaimed emission goes: a deregistered miner's share, and anything the two
# scoring components did not claim.
#WEIGHT_BURN_UID=0
# Set this many blocks (or fewer) before each epoch boundary, so the vector lands just
# before consensus reads it while leaving time for inclusion.
#WEIGHT_SET_MARGIN=12
#WEIGHT_POLL_SECONDS=12

# --- Scoring ----------------------------------------------------------------------
# 60% of emission follows the Pareto frontier, 40% follows recent improvement. What
# neither claims burns, so lowering these dials the whole competition down. See
# docs/SCORING.md for why the default weight function is the one it is.
#SCORING_METHOD=elbow-sweetspot
#SCORING_PARETO_SHARE=0.60
#SCORING_IMPROVEMENT_SHARE=0.40
# How many recent improvements are paid, how much better than the record a submission
# must be to count (relative), and how fast the shares decay from newest to oldest.
#SCORING_IMPROVEMENT_WINDOW=10
#SCORING_IMPROVEMENT_THRESHOLD=0.0025
#SCORING_IMPROVEMENT_DECAY=0.6
# The multiple of the incumbent's time the gate rejects past; also the frontier's time
# boundary. Keep it equal to what the gate actually enforces.
#SCORING_SPEED_FLOOR=8.0
