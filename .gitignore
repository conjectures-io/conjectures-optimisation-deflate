# The slot: overwritten per-submission by verify.py/justfile before every real
# build, so the committed content is never what's actually checked -- see
# validator/slot/generated/'s and validator/lean/Slot/'s own layout.
validator/slot/generated/parse.rs
validator/lean/Slot/Funs.lean
validator/lean/Slot/Types.lean
# Same story: a submission's Parse.lean, staged here by the same
# SUBMISSION_FILES copy in verify.py -- never a stable committed value.
validator/lean/Proof/Parse.lean
